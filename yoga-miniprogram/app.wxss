/* app.wxss - 全局样式 */

page {
  background: #f7f5f2;
  color: #2c2c2c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", Helvetica, "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, image, button, input, textarea, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding: 0 32rpx;
}

/* 主题色 */
.theme-primary {
  color: #b08e6b;
}

.theme-bg {
  background: linear-gradient(135deg, #f5e9dc 0%, #e8d5bd 100%);
}

.btn-primary {
  background: linear-gradient(135deg, #b08e6b 0%, #8a6a4a 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
  border: none;
  letter-spacing: 2rpx;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #b08e6b;
  border: 2rpx solid #b08e6b;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(176, 142, 107, 0.08);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.title-h1 {
  font-size: 48rpx;
  font-weight: 600;
  color: #2c2c2c;
  line-height: 1.3;
}

.title-h2 {
  font-size: 36rpx;
  font-weight: 600;
  color: #2c2c2c;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background: #ececec;
  margin: 24rpx 0;
}
