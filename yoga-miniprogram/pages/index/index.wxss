.page-index {
  padding-bottom: 60rpx;
}

/* Hero */
.hero {
  position: relative;
  margin: 32rpx 0 48rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #d4b896 0%, #b08e6b 60%, #8a6a4a 100%);
}

.hero-content {
  position: relative;
  padding: 48rpx 40rpx 56rpx;
  color: #fff;
}

.hero-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.22);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  margin-bottom: 18rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.92;
  margin-bottom: 32rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 24rpx 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* Section */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.section-title text:first-child {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c2c;
}

.section-tip {
  font-size: 24rpx;
  color: #999;
}

.pose-list {
  padding: 0 8rpx;
}

.footer-tip {
  margin: 40rpx 8rpx 0;
  font-size: 22rpx;
  color: #999;
  line-height: 1.7;
  text-align: center;
  padding: 24rpx;
  background: rgba(176, 142, 107, 0.06);
  border-radius: 16rpx;
}
