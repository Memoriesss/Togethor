.page-result {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* Hero */
.score-hero {
  position: relative;
  margin: 0 0 40rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.score-hero-bg {
  position: absolute;
  inset: 0;
}

.score-hero-content {
  position: relative;
  padding: 80rpx 40rpx 64rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.medal {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(0,0,0,0.2));
}

.pose-name {
  font-size: 32rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.big-score {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.big-num {
  font-size: 140rpx;
  font-weight: 200;
  line-height: 1;
}

.big-unit {
  font-size: 36rpx;
  margin-left: 8rpx;
  opacity: 0.85;
}

.score-level {
  font-size: 30rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.22);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}

.score-msg {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.6;
  max-width: 560rpx;
}

/* Stats */
.stats-row {
  display: flex;
  margin: 0 32rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat-cell + .stat-cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background: #ececec;
}

.stat-num {
  font-size: 56rpx;
  font-weight: 600;
  color: #b08e6b;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.stat-unit {
  font-size: 22rpx;
  color: #b08e6b;
  margin-left: 2rpx;
  margin-top: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* Advice */
.advice-card {
  margin: 0 32rpx 32rpx;
}

.advice-title {
  margin-bottom: 20rpx;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.advice-dot {
  color: #b08e6b;
  font-weight: 600;
  margin-right: 8rpx;
}

.advice-text {
  flex: 1;
}

/* Actions */
.actions {
  display: flex;
  padding: 32rpx;
}
