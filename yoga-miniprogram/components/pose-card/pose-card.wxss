.pose-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.pose-card:active {
  transform: scale(0.98);
  background: #faf6f1;
}

.pose-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f5e9dc 0%, #e8d5bd 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.pose-info {
  flex: 1;
  min-width: 0;
}

.pose-name {
  display: flex;
  align-items: baseline;
  margin-bottom: 6rpx;
}

.name-cn {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-right: 12rpx;
}

.name-en {
  font-size: 22rpx;
  color: #b08e6b;
  font-style: italic;
}

.pose-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.pose-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.diff {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ececec;
  margin-right: 6rpx;
}

.dot.on {
  background: #b08e6b;
}

.diff-text {
  font-size: 22rpx;
  color: #b08e6b;
  margin-left: 10rpx;
}

.duration {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
}

.duration-icon {
  margin-right: 6rpx;
}

.pose-arrow {
  font-size: 48rpx;
  color: #d4d4d4;
  margin-left: 12rpx;
  line-height: 1;
}
